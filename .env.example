CODEX_AUTH_PATH=/var/lib/codex-quota/auths
CODEX_ZECTRIX_DATA_DIR=/var/lib/codex-quota/data
HOST_MACHINE_ID_FILE=/etc/machine-id
ZECTRIX_DEVICE_ID=replace-with-device-id
ZECTRIX_PAGE_ID=1
ZECTRIX_API_BASE=https://cloud.zectrix.com
ZECTRIX_API_KEY_FILE=/var/lib/codex-quota/secrets/zectrix_api_key
CACHE_ENCRYPTION_KEY_FILE=/var/lib/codex-quota/secrets/cache_encryption_key
QUOTA_POLL_SECONDS=1800
QUOTA_PAUSE_WINDOWS=00:00-06:00
TZ=Asia/Shanghai
